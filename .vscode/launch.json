{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: buka di Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "Web: jalankan dev server",
      "sourceMaps": true
    },
    {
      "name": "Web: buka di Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "Web: jalankan dev server",
      "sourceMaps": true
    },
    {
      "//": "Perlu ekstensi Godot Tools. Jalankan proyek Godot (akar repo) dari VS Code.",
      "name": "Godot: jalankan proyek",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "address": "127.0.0.1",
      "port": 6007,
      "scene": "",
      "debug_collisions": false
    }
  ]
}
