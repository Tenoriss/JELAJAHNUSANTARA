{
  "//": "Pengaturan VS Code untuk TAPAK NUSA (Godot di akar, versi web React di web/).",

  "files.exclude": {
    "**/.godot": true,
    "**/node_modules": true,
    "**/web/dist": true,
    "**/web/.shots": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.godot": true,
    "**/node_modules": true,
    "**/web/dist": true,
    "**/web/.shots": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/.godot/**": true,
    "**/node_modules/**": true,
    "**/web/dist/**": true
  },
  "files.associations": {
    "*.tscn": "ini",
    "*.tres": "ini",
    "*.gd": "gdscript"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.tabSize": 2,
  "[gdscript]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "[python]": {
    "editor.tabSize": 4
  },

  "typescript.tsdk": "web/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",

  "terminal.integrated.cwd": "${workspaceFolder}",
  "python.analysis.extraPaths": ["${workspaceFolder}/tools"],

  "godotTools.editorPath.godot4": "godot"
}
