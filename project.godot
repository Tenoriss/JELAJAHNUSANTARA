; Engine configuration file.
; TAPAK NUSA — "Setiap langkah meninggalkan cerita."
; Godot 4.x / GDScript. Desktop.

config_version=5

[application]

config/name="TAPAK NUSA"
config/version="1.0.0"
config/description="Game petualangan 2D tentang gotong royong dan kearifan lokal Indonesia.
Setiap langkah meninggalkan cerita."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.101961, 0.0823529, 0.0627451, 1)

[autoload]

GameManager="*res://autoload/GameManager.gd"
QuestManager="*res://autoload/QuestManager.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
SaveManager="*res://autoload/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/theme/TapakNusa.tres"

